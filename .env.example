# Copy to .env.local. Use the SAME Supabase project as the clinic contacts module
# (sofiagrig/dental-branch-directory), so users sign in with the same username and password.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Must match the clinic contacts module: usernames are stored as <username>@<this domain>.
AUTH_USERNAME_DOMAIN=shinaim.biz
