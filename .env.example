# Copy to .env.local. Use the SAME Supabase project as the clinic contacts module
# (sofiagrig/dental-branch-directory), so users sign in with the same username and password.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Must match the clinic contacts module: usernames are stored as <username>@<this domain>.
AUTH_USERNAME_DOMAIN=shinaim.biz

# Email notifications (optional; without them nothing is sent). Server-side only.
# Secret key: Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Never in the browser.
SUPABASE_SECRET_KEY=
# Resend (resend.com) API key, and a sender on a domain verified there.
RESEND_API_KEY=
NOTIFY_FROM=התייעצות מומחים <consult@shinaim.biz>
# The site's address, for links in the emails.
APP_URL=https://consult.shinaim.net
